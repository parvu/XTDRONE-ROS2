<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>xtdrone_ugv_planning</name>
  <version>0.1.0</version>
  <description>XTDrone UGV motion planning (chapter 31): hybrid A* and pure pursuit for the CAT Vehicle, ported from ROS 1.</description>
  <maintainer email="parvupv@gmail.com">parvu</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>ament_index_cpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>eigen</depend>
  <depend>yaml-cpp</depend>
  <depend>ompl</depend>
  <depend>boost</depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>xtdrone_bringup</exec_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
