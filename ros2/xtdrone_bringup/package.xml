<?xml version="1.0"?>
<package format="3">
  <name>xtdrone_bringup</name>
  <version>0.2.0</version>
  <description>XTDrone launch files for PX4 SITL on Gazebo Harmonic with MAVROS 2.</description>
  <maintainer email="zhuoan@stu.pku.edu.cn">XTDrone contributors</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>mavros</exec_depend>
  <exec_depend>mavros_extras</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>xtdrone_gz</exec_depend>
  <exec_depend>xtdrone_py</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
