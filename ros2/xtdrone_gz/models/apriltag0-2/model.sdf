<?xml version="1.0"?>
<sdf version="1.9">
  <!-- 2.500 m x 1.001 m plate (tags along x, the first ID at -x; the texture is stored rotated by 90 deg because the gz box top face maps image columns to -y), texture from XTDrone's sitl_config/models/apriltag0-2 (black tag squares 0.5 m). -->
  <model name="apriltag0-2">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <pose>0 0 0.005 0 0 0</pose>
        <geometry><box><size>2.5004 1.0007 0.01</size></box></geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 0.005 0 0 0</pose>
        <geometry><box><size>2.5004 1.0007 0.01</size></box></geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr><metal><albedo_map>model://apriltag0-2/materials/textures/apriltag0-2.png</albedo_map><roughness>1</roughness><metalness>0</metalness></metal></pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
