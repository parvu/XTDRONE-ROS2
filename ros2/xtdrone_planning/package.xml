<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>xtdrone_planning</name>
  <version>0.1.0</version>
  <description>XTDrone motion planning chapters on ROS 2 (Nav2 for 2D planning, chapter 20).</description>
  <maintainer email="zhuoan@stu.pku.edu.cn">XTDrone contributors</maintainer>
  <license>MIT</license>

  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>dwb_core</exec_depend>
  <exec_depend>nav2_navfn_planner</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>xtdrone_slam</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
